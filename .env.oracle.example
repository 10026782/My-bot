# .env.oracle.example — M0 Oracle migration readiness template.
#
# NOT a copy of any real secret. This documents the variable SET currently
# live on Render (confirmed 2026-08-28 via a read-only Render API query
# against srv-d80ehsf7f7vs73cq5rn0 — key NAMES only were read, no values
# beyond a handful of already-non-secret operational toggles).
#
# The real file for Oracle (docker-compose.oracle.yml's BOSS_ENV_FILE) must:
#   - live OUTSIDE this repo checkout (e.g. /etc/boss-bot/backend.env) —
#     never inside the git working tree, so a `git clean`/rebuild can't
#     touch it
#   - be chmod 0600, owned by the user the containers run as
#   - never be committed — this file is a template only
#
# "Manual migration" below means: the value must be copied by hand from the
# Render dashboard (Environment tab) — it is a secret and was never read by
# this audit.

# ══ REQUIRED — bot will not start correctly without these ═══════════════
TELEGRAM_TOKEN=                    # manual migration — <bot_id>:<secret>, telebot.TeleBot() raises at import time if malformed
ANTHROPIC_API_KEY=                 # manual migration
ELIYAHU_CHAT_ID=                   # manual migration — owner Telegram chat id
AIRTABLE_API_KEY=                  # manual migration
AIRTABLE_BASE_ID=                  # manual migration
IDENTITY_MAP=                      # manual migration — JSON, owner/partner role map (see .env.example for shape)
OWNER_TELEGRAM_ID=                 # manual migration — cost_monitor.py alert recipient
ENV=production
TZ=Asia/Jerusalem                  # confirmed live value — scheduler.py wall-clock jobs depend on this
SHABBAT_CITY=jerusalem             # confirmed live value — shabbat_guard.py quiet-hours calculation

# ── Live in prod, not in the repo's own .env.example — confirm exact
#    semantics against app.py / tma_api.py before relying on these names ──
ADMIN_CHAT_ID=                     # manual migration
TELEGRAM_CHAT_ID=                  # manual migration
TELEGRAM_WEBHOOK_SECRET=           # manual migration

# ══ REQUIRED for atomic claims — confirmed live, not staging-only ═══════
# FEATURE_ATOMIC_CLAIMS=true and DATABASE_URL are BOTH set in the current
# production Render service (live evidence, not the staging-only picture
# docs/operations/DEPLOYMENT.md implies). Postgres is required today.
FEATURE_ATOMIC_CLAIMS=true
DATABASE_URL=                      # manual migration, or point at docker-compose.oracle.yml's postgres service instead

# ══ OPTIONAL — integration-specific, absence degrades that channel only ═
# WhatsApp / Voice (Twilio)
TWILIO_ACCOUNT_SID=                # manual migration
TWILIO_AUTH_TOKEN=                 # manual migration — webhook HMAC validation breaks silently without this
TWILIO_WHATSAPP_FROM=              # manual migration
TWILIO_WHATSAPP_TO=                # manual migration
TWILIO_SIGNATURE_VALIDATION=true   # confirmed live value

# Meta WhatsApp Cloud API (Phase 1 — inbound; outbound stub per META_OUTBOUND_ENABLED)
META_ACCESS_TOKEN=                 # manual migration
META_PHONE_NUMBER_ID=              # manual migration
META_VERIFY_TOKEN=                 # manual migration
META_WABA_ID=                      # manual migration
META_OUTBOUND_ENABLED=false        # confirmed live value

# Google Workspace — live evidence shows GOOGLE_CLIENT_ID/SECRET/REFRESH_TOKEN
# ARE all set in production. This contradicts CLAUDE.md's "(currently
# frozen)" note — flagged in docs/operations/ORACLE_MIGRATION_M0.md, not
# resolved here. Migrate as-is; do not assume it's actually dormant.
GOOGLE_CLIENT_ID=                  # manual migration
GOOGLE_CLIENT_SECRET=              # manual migration
GOOGLE_REFRESH_TOKEN=              # manual migration
GOOGLE_DRIVE_ARTIFACT_FOLDER_ID=   # manual migration — core/google_drive_artifact_store.py
# NOTE: the live Render dashboard also has a key literally named
# "GOOGLE_DRIVE_FOLDER_IDGOOGLE_DRIVE_FOLDER_IDGOOGLE_DRIVE_FOLDER_ID" —
# a malformed/tripled key name, almost certainly a dashboard copy-paste
# artifact. Not reproduced here. Flag to the owner before migration; do not
# silently guess which single variable it was meant to be.

# OpenAI fallback (llm_fallback.py) + Whisper STT fallback (voice_stt_adapter.py)
OPENAI_API_KEY=                    # manual migration
OPENAI_FALLBACK_ENABLED=true       # confirmed live value
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# TMA dashboard
TMA_ALLOWED_ORIGINS=               # manual migration — must include the Oracle-era Vercel/TMA origin, not just the Render-era one

# Misc
WORKER_SECRET=                     # manual migration — /worker/trigger auth
DIGEST_CHAT_ID=                    # manual migration
DIGEST_TIME=08:06                  # confirmed live value
OWNER_PHONES=                      # manual migration
STAFF_PHONES=                      # manual migration
SETUP_WEBHOOK=1                    # confirmed live value — per .env.example this is meant to be a one-time flag, removed after first webhook registration; it is NOT unset in production today. Re-verify intent before carrying this forward as a permanent env var on Oracle.

# ══ RENDER-ONLY — do not carry forward to Oracle ════════════════════════
# PORT             — Render injects this; Oracle sets it via docker-compose.oracle.yml's `environment:` instead
# PYTHON_VERSION   — Render buildpack signal; Oracle pins the version via the Dockerfile's base image instead
# RENDER_APP_URL   — only meaningful to run_local.sh's ngrok tunnel workflow

# ══ FEATURE-SPECIFIC — booleans, default off per feature_flags.py convention
# unless a confirmed live value is shown. Full canonical list/defaults live
# in feature_flags.py's own module docstring — treat this as a migration
# checklist, not the source of truth for defaults.
FEATURE_ACTION_CONTRACT_PERSISTENCE=
FEATURE_ACTION_GATEWAY=
FEATURE_AIRTABLE_RUNTIME_SCHEMA_PROVIDER_STATE=
FEATURE_AIRTABLE_SELECT_VALUE_VALIDATION_STATE=
FEATURE_AUTO_CAPTURE=
FEATURE_BUSINESS_UPDATE=
FEATURE_CORE_REASONING_LEADS_STATE=
FEATURE_DECISION_AUTO_INGESTION=
FEATURE_DECISION_HUB=
FEATURE_DETERMINISTIC_APPROVAL_COST_CUTS=
FEATURE_EVIDENCE_FINALIZER=
FEATURE_MARKETING_BRIDGE=
FEATURE_MEDIA_UPLOAD=
FEATURE_PA01_ENFORCEMENT_STATE=
FEATURE_SINGLE_SPEAKER_APPROVAL_UX=
FEATURE_STRUCTURED_FILE_CAPTURE=
FEATURE_TOOL_AVAILABILITY_FILTER=
FEATURE_UNIFIED_STATUS_FORMATTER=
FEATURE_VOICE_NOTES=
INTERACTION_INTELLIGENCE=
LEAD_CAPTURE=false                 # confirmed live value
LEAD_MEMORY=true                   # confirmed live value
LEAD_QUALIFIER=
LEAD_SCORING=true                  # confirmed live value
LEAD_SCORING_LIVE=false            # confirmed live value
MPT_ARTIFACT_STORAGE=
EMERGENCY_STOP_ALL=                # Airtable-backed canonical flag — see feature_flags.py / core/emergency_stop.py
EMERGENCY_STOP_WHATSAPP=           # same
GIT_AUDIT_SCHEDULER=false          # confirmed live value
COST_WATCHDOG_LIVE=false           # confirmed live value
COST_DAILY_LIMIT=2                 # confirmed live value ($/day)
COST_HOURLY_LIMIT=0.25             # confirmed live value ($/hour, alert-only)
