# .env.example — העתק לקובץ .env ומלא את הערכים
# אל תעלה את .env ל-git !

# ── חובה ──────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELIYAHU_CHAT_ID=your_telegram_chat_id_here

# ── Airtable (CRM) ─────────────────────────────────
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# ── אופציונלי ──────────────────────────────────────
WORKER_SECRET=choose_a_random_secret_string
# IDENTITY_MAP={"telegram:123456":{"tenant":"boss_hq","user":"eliyahu","role":"owner","name":"אליהו חזן"}}

