# .env.example — העתק לקובץ .env ומלא את הערכים
# אל תעלה את .env ל-git !

# ── חובה ──────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_FALLBACK_ENABLED=false
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
ELIYAHU_CHAT_ID=your_telegram_chat_id_here

# ── Airtable (CRM) ─────────────────────────────────
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# ── Identity map (owner/partner roles) ────────────
# IDENTITY_MAP={"telegram:123456":{"tenant":"boss_hq","user":"eliyahu","role":"owner","name":"אליהו חזן"}}

# ── אופציונלי ──────────────────────────────────────
WORKER_SECRET=choose_a_random_secret_string

# ── WhatsApp / Twilio ──────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=                 # app.py webhook validation — בלי זה webhook validation נשבר בשקט
# TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Google Workspace (currently frozen) ────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=              # tools/google_tools.py — Drive/Calendar/Gmail ייכשלו ב-runtime

# ── Scheduler / Digest ─────────────────────────────
# DIGEST_CHAT_ID=                    # scheduler.py — בלי זה digest/payments/recovery נכשלים בשקט
# OWNER_TELEGRAM_ID=                 # cost_monitor.py — בלי זה cost alerts לא מגיעים

# ── TMA Dashboard ──────────────────────────────────
# TMA_ALLOWED_ORIGINS=https://your-tma.vercel.app  # tma_api.py — בלי זה CORS נשבר ב-TMA

# ── Lead Capture & Scoring ─────────────────────────
# LEAD_CAPTURE=false                 # lead_capture.py — הפעלת capture מ-WhatsApp
# LEAD_SCORING=false                 # lead_capture.py — הפעלת ציון אוטומטי בעת capture

# ── OpenAI Fallback (llm_fallback.py) ──────────────
# OPENAI_API_KEY=sk-...
# OPENAI_FALLBACK_ENABLED=false      # true = פעיל; false = כבוי (ברירת מחדל)
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Cost Watchdog (CORE_05) ────────────────────────
# COST_WATCHDOG_LIVE=true
# COST_HOURLY_LIMIT=5.0              # $ per hour — alert only
# COST_DAILY_LIMIT=20.0              # $ per day  — triggers EMERGENCY_STOP_AI

# ── Meta WhatsApp Cloud API (Phase 1 — inbound only, outbound stub) ──
# META_VERIFY_TOKEN=                 # token שמגדירים ב-Meta App Dashboard עבור webhook verify
# META_APP_SECRET=                   # App Secret מ-Meta App Dashboard — לאימות HMAC-SHA256
# META_PHONE_NUMBER_ID=              # Phone Number ID מ-Meta Business (לשימוש עתידי — outbound)
# META_ACCESS_TOKEN=                 # Access Token ל-Graph API (לשימוש עתידי — outbound)

# ── מנוהל אוטומטית ע"י run_local.sh ───────────────
# RENDER_APP_URL=https://xxxx.ngrok-free.app
# SETUP_WEBHOOK=1
