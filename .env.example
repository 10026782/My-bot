# .env.example — העתק לקובץ .env ומלא את הערכים
# אל תעלה את .env ל-git !

# ── חובה ──────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_FALLBACK_ENABLED=false
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
ELIYAHU_CHAT_ID=your_telegram_chat_id_here

# ── Airtable (CRM) ─────────────────────────────────
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# ── Identity map (owner/partner roles) ────────────
# IDENTITY_MAP={"telegram:123456":{"tenant":"boss_hq","user":"eliyahu","role":"owner","name":"אליהו חזן"}}

# ── אופציונלי ──────────────────────────────────────
WORKER_SECRET=choose_a_random_secret_string

# ── WhatsApp / Twilio ──────────────────────────────
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=                 # app.py webhook validation — בלי זה webhook validation נשבר בשקט
# TWILIO_WHATSAPP_NUMBER=+14155238886
# FURNITURE_TWILIO_WHATSAPP_NUMBER=    # מספר Twilio ייעודי לפאנל הרהיטים — בלי זה הפאנל לא מופעל

# ── Google Workspace (currently frozen) ────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=              # tools/google_tools.py — Drive/Calendar/Gmail ייכשלו ב-runtime

# ── Scheduler / Digest ─────────────────────────────
# DIGEST_CHAT_ID=                    # scheduler.py — בלי זה digest/payments/recovery נכשלים בשקט
# GIT_AUDIT_TIME=06:45               # scheduler.py — שעת דוח תקינות Git/Config יומי (daily_git_audit.py); דורש GIT_AUDIT_SCHEDULER=true
# OWNER_TELEGRAM_ID=                 # cost_monitor.py — בלי זה cost alerts לא מגיעים

# ── TMA Dashboard ──────────────────────────────────
# TMA_ALLOWED_ORIGINS=https://your-tma.vercel.app  # tma_api.py — בלי זה CORS נשבר ב-TMA

# ── Lead Capture & Scoring ─────────────────────────
# LEAD_CAPTURE=false                 # lead_capture.py — הפעלת capture מ-WhatsApp
# LEAD_SCORING=false                 # lead_capture.py — הפעלת ציון אוטומטי בעת capture

# ── OpenAI Fallback (llm_fallback.py) ──────────────
# OPENAI_API_KEY=sk-...
# OPENAI_FALLBACK_ENABLED=false      # true = פעיל; false = כבוי (ברירת מחדל)
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# ── Cost Watchdog (CORE_05) ────────────────────────
# COST_WATCHDOG_LIVE=true
# COST_WATCHDOG_ENABLED=true         # core/cost_watchdog.py — overrides COST_WATCHDOG_LIVE if set
# SONNET_DAILY_LIMIT=100000          # core/cost_watchdog.py — daily claude_sonnet call-count threshold
# COST_HOURLY_LIMIT=5.0              # $ per hour — alert only
# COST_DAILY_LIMIT=20.0              # $ per day  — triggers EMERGENCY_STOP_AI

# ── Meta WhatsApp Cloud API (Phase 1 — inbound only, outbound stub) ──
# META_VERIFY_TOKEN=                 # token שמגדירים ב-Meta App Dashboard עבור webhook verify
# META_APP_SECRET=                   # App Secret מ-Meta App Dashboard — לאימות HMAC-SHA256
# META_PHONE_NUMBER_ID=              # Phone Number ID מ-Meta Business (לשימוש עתידי — outbound)
# META_ACCESS_TOKEN=                 # Access Token ל-Graph API (לשימוש עתידי — outbound)
META_OUTBOUND_ENABLED=false          # app.py — true מפעיל run_agent על inbound; false חוסך טוקנים כל עוד outbound הוא stub

# ── מנוהל אוטומטית ע"י run_local.sh ───────────────
# RENDER_APP_URL=https://xxxx.ngrok-free.app
# SETUP_WEBHOOK=1

# ── Media Layer (F16 — voice notes + file storage) ─
# FEATURE_VOICE_NOTES=false          # feature_flags.py — תמלול הודעות קוליות (Telegram)
# FEATURE_MEDIA_UPLOAD=false         # feature_flags.py — שמירת תמונות/קבצים ל-Drive (Telegram + TMA)
# GROQ_API_KEY=                      # voice_stt_adapter.py — STT ראשי; ללא זה נופל ל-OpenAI Whisper
# GOOGLE_DRIVE_FOLDER_ID=            # drive_adapter.py — תיקיית שורש BOSS ב-Drive; ללא זה נופל ל-"root"

# ── PostgreSQL (Phase 4B0.1 Atomic Coordination) ─
# FEATURE_ATOMIC_CLAIMS=false        # atomic_claim_repository.py — PostgreSQL-backed execution claims
# DATABASE_URL=postgresql://user:password@localhost:5432/boss_bot  # Render standard (takes precedence)
# Or use individual env vars:
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=boss_bot
# DATABASE_USER=postgres
# DATABASE_PASSWORD=password
